 javascript:(function(){function randomizeNumber(){var digitCount=Math.floor(Math.random()*12)+1;var minVal=(digitCount===1)?0:Math.pow(10,digitCount-1);var maxVal=Math.pow(10,digitCount)-1;return Math.floor(Math.random()*(maxVal-minVal+1))+minVal;}function processNode(node){if(node.nodeType===3){var text=node.nodeValue;var newText=text.replace(/\b\d+(\.\d+)?\b/g,function(match){if(match.indexOf('.')!==-1){return randomizeNumber()+'.'+randomizeNumber();}else{return randomizeNumber();}});if(text!==newText){node.nodeValue=newText;}}else if(node.nodeType===1&&node.nodeName!=='SCRIPT'&&node.nodeName!=='STYLE'&&node.nodeName!=='NOSCRIPT'){for(var i=0;i<node.childNodes.length;i++){processNode(node.childNodes[i]);}}}try{processNode(document.body);alert('Numbers on the page have been randomized with varying digit counts!');}catch(e){alert('An error occurred: '+e.message);}})();  
